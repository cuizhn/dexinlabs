# dexinlabs — 环境变量示例
#
# 使用方式：
#   1) 将本文件复制为 .env
#   2) 按实际环境填写 <...> 占位符，或取消注释适配本地的行
# ==============================================================================

# ── 数据库连接（必填，Runtime + Publish API + Migrations 都需要）
#    本地 PostgreSQL (推荐 Docker)
DATABASE_URL="postgresql://postgres:<your-password>@localhost:5432/dexinlabs"
#    或 Neon 生产：
# DATABASE_URL="postgresql://neondb_owner:<your-token>@ep-xxx-pooler.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# ── Publish API 共享密钥（必填）
#    由 dexinlabs-content 侧 scripts/publish-content.mjs 在 POST /api/content-package 时以
#    Header "x-publish-token: <值>" 提供；不匹配则 401。
#    请使用足够复杂的随机字符串（例如 `openssl rand -base64 32` 的输出）。
PUBLISH_TOKEN="<change-me-to-a-long-random-string>"

# ── Nuxt 应用（可选）
# NUXT_PUBLIC_SITE_URL="https://dexinlabs.example.com"
# NUXT_HOST=0.0.0.0
# NUXT_PORT=3000
