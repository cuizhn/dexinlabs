# 依赖目录
node_modules/

# Nuxt 构建产物
.nuxt/
.output/
dist/

# 环境变量（绝不提交密钥）
.env
.env.*.local

# 日志文件
logs/
*.log
npm-debug.log*

# 编辑器与系统文件
.DS_Store
Thumbs.db
*.swp
*.swo

# TypeScript 缓存
*.tsbuildinfo

# 测试覆盖率
coverage/
.nyc_output/

# 内容编译产物（ADR-014）
compile/output/

# VitePress 构建缓存（内容预览工具）
.vitepress/cache/
.vitepress/dist/
lessons/
.workbuddy/

# 工具脚本源码纳入 Git（ADR-014 内容编译管线）：
# tools/content-compiler/ 等源码应入库，保证全新 clone 可复现内容编译环境。
# 但工具内部的产物 / 缓存 / 依赖继续忽略，避免误提交编译输出。
tools/**/output
tools/**/dist
tools/**/node_modules
tools/**/.cache
tools/**/*.log
